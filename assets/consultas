async function guardarMunicipio() {
    const boton = document.getElementById("btnGuardar");
    const textoOriginal = boton.textContent;


    boton.textContent = 'Guardando...';
    boton.disabled = true;

    try {
        const docRef = doc(db, "Municipios", "Municipios_Ver");
        await setDoc(docRef, {
            lista: listaMunicipios
        });
        alert("Municipios guardados correctamente");
        boton.textContent = "Completado";

    } catch (error) {
        console.error("Error al guardar municipios: ", error);
        alert("Error al guardar municipios. Revisa la consola para más detalles.");
        boton.textContent = textoOriginal;
        boton.disabled = false;
    }
}
const boton = document.getElementById("btnGuardar");
boton.addEventListener("click", () => {
    guardarMunicipio();
});
